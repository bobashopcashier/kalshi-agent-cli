{
  "id": "kalshi-cli",
  "name": "Kalshi CLI",
  "description": "Stable, bounded Kalshi tools for OpenClaw agents.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "binaryPath": {
        "type": "string",
        "minLength": 1,
        "description": "Path to the kalshi executable. Defaults to kalshi on PATH."
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "kalshi_query"
    ]
  },
  "toolMetadata": {
    "kalshi_query": {
      "optional": true,
      "replaySafe": true
    }
  }
}
