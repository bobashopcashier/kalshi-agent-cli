{
  "name": "@bobashopcashier/kalshi-cli",
  "version": "0.1.0",
  "description": "Stable, bounded Kalshi tools for OpenClaw agents.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobashopcashier/kalshi-cli.git",
    "directory": "plugins/openclaw"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts",
    "prepack": "npm run plugin:validate && npm test"
  },
  "dependencies": {
    "typebox": "1.3.9"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:@bobashopcashier/kalshi-cli",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.7.1-2"
    },
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "release": {
      "publishToClawHub": true
    }
  }
}
